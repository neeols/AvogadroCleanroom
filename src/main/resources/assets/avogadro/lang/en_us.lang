# =============================================================================
avogadro.configuration.enableTooltips=Show Item & Fluid Tooltip Molecules
avogadro.configuration.enableTooltips.tooltip=Show molecule models in matching item, filled-container and direct-fluid tooltips, including HEI ingredients and bookmarks. Independent of the HEI Molecules page and world HUDs. Native descriptions remain unchanged.

avogadro.configuration.tooltipSize=Tooltip Size
avogadro.configuration.tooltipSize.tooltip=Molecule image size in GUI pixels. Minimum: 16 px. Maximum: 128 px. Default: 64 px.

# =============================================================================
# CONFIGURATION - APPEARANCE
# =============================================================================
avogadro.configuration.spinSeconds=Rotation Period (Seconds)
avogadro.configuration.spinSeconds.tooltip=Seconds per automatic rotation. Minimum: 0.5 s. Maximum: 60 s. Default: 6 s.

avogadro.configuration.rotationDirection=Rotation Direction
avogadro.configuration.rotationDirection.tooltip=FORWARD keeps the original automatic direction. REVERSE spins the other way. Mouse dragging follows the pointer in either mode.

avogadro.configuration.cubicAtoms=Cubic Atoms
avogadro.configuration.cubicAtoms.tooltip=Use cubic atoms and square bonds instead of spheres and cylinders.

avogadro.configuration.textScale=Molecule Text Scale
avogadro.configuration.textScale.tooltip=Scale Avogadro's name and formula labels. Minimum: 0.5×. Maximum: 3×. Default: 1×. Labels fit their available space. Native item descriptions and HUD text are unchanged.

avogadro.configuration.renderingMode=Rendering Mode
avogadro.configuration.renderingMode.tooltip=LIVE keeps camera controls. PRERENDERED caches full-geometry tooltip, HEI and HUD animations with a fixed camera and 120 angular frames. HEI camera controls are disabled. Large previews fall back to live geometry when the texture budget is exceeded. Exports and molecule items always use live geometry.

avogadro.configuration.creativeSort=Creative tab sorting
avogadro.configuration.creativeSort.tooltip=Sort molecule samples by translated name, formula, identifier, or registration order.

avogadro.configuration.elementSort=Elements tab sorting
avogadro.configuration.elementSort.tooltip=Sort elements by configured atomic number (protons), name, formula, identifier, or registration order.

avogadro.configuration.splitCreativeTabs=Separate Elements and Molecules tabs
avogadro.configuration.splitCreativeTabs.tooltip=Separate elemental samples from compounds. Disable to combine both in Molecules. Requires restart.

avogadro.config.separateCrystalTab=Separate crystal tab
avogadro.configuration.separatePolymerTab=Separate polymer tab

